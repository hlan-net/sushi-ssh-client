<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/ssh_section_title"
            style="@style/TextAppearance.Sushi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ssh_section_title" />

        <TextView
            android:id="@+id/ssh_section_subtitle"
            style="@style/TextAppearance.Sushi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ssh_section_subtitle" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/sushi_white"
            app:cardElevation="1dp"
            app:strokeColor="@color/sushi_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/settings_summary_title"
                    style="@style/TextAppearance.Sushi.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_summary_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/summary_host_label"
                        style="@style/TextAppearance.Sushi.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_summary_host_label" />

                    <TextView
                        android:id="@+id/summary_host_value"
                        style="@style/TextAppearance.Sushi.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/settings_summary_host_none" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/summary_auth_label"
                        style="@style/TextAppearance.Sushi.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_summary_auth_label" />

                    <TextView
                        android:id="@+id/summary_auth_value"
                        style="@style/TextAppearance.Sushi.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/settings_summary_auth_none" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/summary_gemini_label"
                        style="@style/TextAppearance.Sushi.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_summary_gemini_label" />

                    <TextView
                        android:id="@+id/summary_gemini_value"
                        style="@style/TextAppearance.Sushi.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/settings_summary_gemini_disabled" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/summary_drive_label"
                        style="@style/TextAppearance.Sushi.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_summary_drive_label" />

                    <TextView
                        android:id="@+id/summary_drive_value"
                        style="@style/TextAppearance.Sushi.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/settings_summary_drive_signed_out" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/test_connection_button"
            style="@style/Widget.Sushi.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_test_connection"
            app:icon="@drawable/ic_wifi_tethering"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/test_connection_result_text"
            style="@style/TextAppearance.Sushi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/test_connection_idle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_connection_diagnostics_button"
            style="@style/Widget.Sushi.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/action_copy_connection_diagnostics"
            android:visibility="gone"
            app:icon="@drawable/ic_content_copy"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/hosts_keys_section_title"
            style="@style/TextAppearance.Sushi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_hosts_keys_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manage_hosts_button"
            style="@style/Widget.Sushi.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_hosts"
            app:icon="@drawable/ic_dns"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_generate_key_button"
            style="@style/Widget.Sushi.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_generate_key_quick"
            app:icon="@drawable/ic_vpn_key"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manage_host_keys_button"
            style="@style/Widget.Sushi.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/host_keys_title"
            app:icon="@drawable/ic_vpn_key"
            app:iconGravity="textStart" />

    </LinearLayout>
</ScrollView>
