<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/gemini_section_title"
            style="@style/TextAppearance.Sushi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gemini_settings_section_title" />

        <TextView
            android:id="@+id/settings_gemini_subtitle"
            style="@style/TextAppearance.Sushi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/gemini_settings_subtitle" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/gemini_enabled_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gemini_settings_toggle" />

        <TextView
            android:id="@+id/gemini_auth_status_text"
            style="@style/TextAppearance.Sushi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/api_key_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/gemini_api_key_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/api_key_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/api_key_helper"
            style="@style/TextAppearance.Sushi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/gemini_api_key_helper" />

        <!-- ── Cloud model section ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="?attr/colorOutline" />

        <TextView
            android:id="@+id/gemini_model_section_title"
            style="@style/TextAppearance.Sushi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gemini_model_section_title" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/gemini_model_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gemini_model_flash"
                style="@style/Widget.Sushi.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gemini_model_flash" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gemini_model_pro"
                style="@style/Widget.Sushi.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gemini_model_pro" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/gemini_model_helper"
            style="@style/TextAppearance.Sushi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/gemini_model_helper" />

        <!-- ── On-device Nano section ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="?attr/colorOutline" />

        <TextView
            android:id="@+id/gemini_nano_section_title"
            style="@style/TextAppearance.Sushi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gemini_nano_section_title" />

        <TextView
            android:id="@+id/nano_status_text"
            style="@style/TextAppearance.Sushi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/gemini_nano_status_unavailable" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nano_download_button"
            style="@style/Widget.Sushi.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/gemini_nano_download_button"
            android:visibility="gone"
            app:icon="@drawable/ic_cloud_download"
            app:iconGravity="textStart" />

        <ProgressBar
            android:id="@+id/nano_download_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="100"
            android:visibility="gone" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/nano_preferred_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/gemini_nano_preferred_toggle" />

        <TextView
            android:id="@+id/nano_preferred_helper"
            style="@style/TextAppearance.Sushi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gemini_nano_preferred_helper" />

        <!-- ── Persona section ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="?attr/colorOutline" />

        <TextView
            android:id="@+id/persona_section_title"
            style="@style/TextAppearance.Sushi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/persona_section_title" />

        <TextView
            android:id="@+id/persona_section_helper"
            style="@style/TextAppearance.Sushi.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/persona_section_helper" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_persona_button"
            style="@style/Widget.Sushi.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/persona_edit_button"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart" />

    </LinearLayout>
</ScrollView>
