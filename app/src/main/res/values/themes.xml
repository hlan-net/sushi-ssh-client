<resources>
    <style name="Theme.Sushi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sushi_green</item>
        <item name="colorOnPrimary">@color/sushi_white</item>
        <item name="colorSecondary">@color/sushi_ink</item>
        <item name="colorOnSecondary">@color/sushi_white</item>
        <item name="colorSurface">@color/sushi_mist</item>
        <item name="colorOnSurface">@color/sushi_ink</item>
        <item name="android:statusBarColor">@color/sushi_ink</item>
        <item name="android:navigationBarColor">@color/sushi_ink</item>
        <item name="materialButtonStyle">@style/Widget.Sushi.PrimaryButton</item>
    </style>

    <style name="TextAppearance.Sushi.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/sushi_ink</item>
    </style>

    <style name="TextAppearance.Sushi.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/sushi_slate</item>
    </style>

    <style name="TextAppearance.Sushi.Caption" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/sushi_slate</item>
    </style>

    <style name="Widget.Sushi.PrimaryButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Sushi.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/sushi_ink</item>
        <item name="iconTint">@color/sushi_ink</item>
        <item name="strokeColor">@color/sushi_card_stroke</item>
        <item name="rippleColor">@color/sushi_card_stroke</item>
    </style>

    <style name="Widget.Sushi.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/sushi_ink</item>
        <item name="iconTint">@color/sushi_ink</item>
        <item name="rippleColor">@color/sushi_card_stroke</item>
    </style>

    <!-- Accent color overlays: applied at runtime per-Activity via AppThemeSettings.applyAccentOverlay,
         based on the user's Settings > General > Accent color choice. Each only swaps colorPrimary;
         the referenced @color already resolves separately for light/dark via values-night/colors.xml. -->
    <style name="ThemeOverlay.Sushi.Coral" parent="">
        <item name="colorPrimary">@color/sushi_green</item>
    </style>

    <style name="ThemeOverlay.Sushi.Wasabi" parent="">
        <item name="colorPrimary">@color/sushi_accent_wasabi</item>
    </style>

    <style name="ThemeOverlay.Sushi.GariAmber" parent="">
        <item name="colorPrimary">@color/sushi_accent_gari</item>
    </style>

    <style name="ThemeOverlay.Sushi.Terracotta" parent="">
        <item name="colorPrimary">@color/sushi_accent_terracotta</item>
    </style>
</resources>
